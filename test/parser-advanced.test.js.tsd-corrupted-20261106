test("数据校验：真实物料库 material-map.json 中 6025 哑光白 归属 M-2911", () => {
  const here = path.dirname(fileURLToPath(import.meta.url));
  const map = JSON.parse(fs.readFileSync(path.join(here, "../data/material-map.json"), "utf8"));
  const item = (map.materials || []).find((m) => (m.aliases || []).includes("6025"));
  assert.ok(item, "物料库缺少 6025 父条目");
  const v = (item.variants || []).find((x) => x.finish === "哑光" && x.color === "白色");
  assert.ok(v, "6025 缺少 哑光+白色 变体");
  assert.equal(v.modelCode, "2911");
  assert.equal(v.outputText, "6025 哑光白");

  // 该变体必须能在真实物料库中查到实体，且名字为「L片（铝片）哑光白色」
  const target = (map.materials || []).find((m) => (m.aliases || []).includes("2911"));
  assert.ok(target, "物料库缺少 2911 条目");
  assert.equal(target.searchText, "L片哑光白色");
});

