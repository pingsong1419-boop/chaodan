test("后台网络拦截提取订单结构并驱动解析器", () => {
  // 模拟从聚水潭网络拦截到的原始 JSON 订单数据
  const mockJstOrder = {
    so_id: "2598202",
    buyer_name: "y**",
    seller_memo: "线上预售 以旧换新·国家补贴 改 6025 免钉【哑光】灰色 制作宽0.51米 高1.38米",
    buyer_memo: "",
    pay_amount: 137.99,
    receiver_address: "江西省九江市彭泽县发运镇龙*镇免子山九江心莲化话**公司.(闫**)(1**********)",
    items: [
      { name: "6025加厚百叶帘", sku_name: "免钉【哑光】灰色 0.51*1.38", qty: 1 }
    ]
  };

  // 拼接出的标准化订单报文
  const combinedText = [
    mockJstOrder.so_id,
    mockJstOrder.buyer_name,
    mockJstOrder.seller_memo,
    mockJstOrder.buyer_memo,
    mockJstOrder.items.map(i => `${i.name} ${i.sku_name} ${i.qty}`).join(" "),
    `已付金额: ${mockJstOrder.pay_amount}`,
    mockJstOrder.receiver_address
  ].filter(Boolean).join(" ");

  const parsed = parseOrderText(combinedText);
  assert.equal(parsed.productCode, "6025");
  assert.equal(parsed.width, 0.51);
  assert.equal(parsed.height, 1.38);
  assert.deepEqual(parsed.colors, ["灰色"]);
  assert.ok(parsed.crafts.includes("免打孔"));
  assert.ok(parsed.crafts.includes("哑光"));

  const materials = [
    { aliases: ["2718"], searchText: "哑光灰色", status: "confirmed" }
  ];
  const resolved = resolveMaterialText(parsed, materials);
  assert.equal(resolved.outputText, "6025 哑光灰");
  assert.equal(parseAmount(combinedText), "137.99");
});

